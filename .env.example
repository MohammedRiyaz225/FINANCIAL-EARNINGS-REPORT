# ==============================================================================
# Financial Earnings Report Analysis Desk (FERAD) - Environment Template
# ==============================================================================
# Copy this file to .env and configure your variables as needed.
# By default, the system runs in high-speed, deterministic offline mode.

# Execution Mode: "offline" (rule/RAG grounded, no external API keys required) or "llm"
EXECUTION_MODE=offline

# ------------------------------------------------------------------------------
# Microsoft Semantic Kernel / Azure OpenAI Configuration (Optional for LLM mode)
# ------------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ------------------------------------------------------------------------------
# OpenAI Direct API Configuration (Optional alternative for LLM mode)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o

# ------------------------------------------------------------------------------
# Groq API Configuration (Optional - High-Speed Llama-3.3 / Mixtral inference)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# System & Output Configuration
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
RUN_LOG_FILE=run_log.jsonl
OUTPUT_NOTE_FILE=analyst_note.md
ENABLE_RICH_CONSOLE=true
